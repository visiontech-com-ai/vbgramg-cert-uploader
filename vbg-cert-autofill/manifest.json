{
  "manifest_version": 3,
  "name": "VB-G RAM G Certificate Auto-Fill",
  "version": "1.0.0",
  "key": "",
  "description": "Fills all 8 certificate blocks (signing-authority details + PDF uploads) on the VB-G RAM G Work Entry page in one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "options.html",
    "default_title": "Certificate Auto-Fill — signing details",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.dord.gov.in/vbgramg/work_entry.aspx*"
      ],
      "js": ["lib/pdf.min.js", "lib/pdf.worker.min.js", "lib/jspdf.umd.min.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.worker.min.js"],
      "matches": ["https://*.dord.gov.in/*"]
    }
  ]
}
